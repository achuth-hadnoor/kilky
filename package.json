{
  "name": "kliky",
  "productName": "Kliky",
  "author": "Achuth",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && yarn lint && vite build",
    "lint": "eslint .",
    "type-check": "tsc",

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kliky",
  "version": "0.1.0",
  "identifier": "com.achuth.kliky",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/achuth/cliky/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZFMDA4M0MzNjcyRDQwNEMKUldSTVFDMW53NE1BL3RidlZxalJnRS9vSjQxVGt2SXU4dFdicXR2by9RWGp0UFVtRCtKakR5VFkK"
    }
  }
}

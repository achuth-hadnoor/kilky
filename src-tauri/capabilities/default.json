{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "kliky_ui",
    "settings",
    "onboarding",
    "playground"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "opener:default",
    "dialog:default",
    "dialog:allow-open",
    "fs:default",
    "updater:default",
    "autostart:default",
    "process:allow-restart",
    "core:event:default",
    "core:window:allow-close",
    "core:window:allow-hide",
    "store:default",
    "http:default"
  ]
}